{
  "name": "zentrix-portal-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker Hono API with D1 database for Zentrixs Enterprise Task Hub",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute zentrix-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute zentrix-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "typescript": "^5.0.4",
    "wrangler": "^3.30.0"
  }
}
